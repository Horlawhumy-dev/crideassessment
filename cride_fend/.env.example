# Origin the Next.js server calls for the NestJS API. Server-side only — it is
# read in app/api/[...path]/route.ts and never reaches the browser.
API_URL=http://localhost:4000

# Origin the browser opens the Socket.IO connection against. Must be public:
# the WebSocket handshake is NOT proxied through Next, it goes straight to the
# API and authenticates with the httpOnly `cride.sid` cookie.
NEXT_PUBLIC_API_URL=http://localhost:4000
