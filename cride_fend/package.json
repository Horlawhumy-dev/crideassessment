{
  "name": "cride-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "node scripts/generate-api-types.mjs",
    "check:api": "node scripts/check-api-contract.mjs",
    "check:styles": "node scripts/check-no-arbitrary-colors.mjs",
