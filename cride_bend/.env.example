# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# api = HTTP + websocket only | worker = outbox relay + queue consumers only
# | all  = both, which is the convenient default for local development.
APP_ROLE=all

# Comma-separated list. Credentials must be enabled for the session cookie, so
# "*" is rejected at boot in production.
CORS_ORIGIN=http://localhost:3000

# ---- Data -------------------------------------------------------------------
# PostgreSQL is the source of truth. Redis is a cache, queue and event bus.
DATABASE_URL=postgresql://cride:cride@localhost:5432/cride?schema=public
REDIS_URL=redis://localhost:6379

# ---- Auth -------------------------------------------------------------------
# Must be >= 16 chars. The dev default is rejected when NODE_ENV=production.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-insecure-refresh-change-me
JWT_REFRESH_TTL_DAYS=30
# 12 is the current sensible cost factor. Lowering it for test speed is fine;
# anything under 10 in production is not.
BCRYPT_ROUNDS=12

# ---- Rate limiting ----------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
# Applied to /auth/login and /auth/register. Credential stuffing is the threat
# this number actually addresses.
AUTH_THROTTLE_LIMIT=5

# ---- Ride behaviour ---------------------------------------------------------
RIDE_CACHE_TTL_SECONDS=30
RIDE_OFFER_TTL_MINUTES=10
RIDE_EXPIRY_SWEEP_INTERVAL_MS=60000

# ---- Driver location (§4.9) -------------------------------------------------
# How long a position is considered fresh.
LOCATION_TTL_SECONDS=90
# Minimum gap between accepted frames from one driver on one ride. This is the
# per-driver rate limit and it is enforced in Redis, not in process memory.
LOCATION_MIN_INTERVAL_MS=3000
# A frame further than this from the last accepted position is rejected as a
# teleport. 2000m at 3s intervals is far above any achievable speed.
LOCATION_MAX_JUMP_METRES=2000

# ---- Push (FCM) -------------------------------------------------------------
# All-or-none: set FCM_ENABLED=true only alongside all three credentials below.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Newlines must be escaped as \n in this file; the adapter unescapes them.
FIREBASE_PRIVATE_KEY=

# ---- Tracing ----------------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=cride-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Deferred features (§9.1) ----------------------------------------------
# Nearest-driver matching is intentionally off. The seam exists
# (DriverOfferHandler) but the product doc defers the work.
DRIVER_MATCHING_ENABLED=false

REQUEST_TIMEOUT_MS=8000
